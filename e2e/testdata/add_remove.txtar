[!exec:git] skip 'git not available'

# Set up a project with a remote repo that has extra branches
setup-repo develop feature/login
setup-project

cd $WORK/project

# Add a worktree for the default branch
exec wtx add --skip-setup main
exists worktrees/main

# List should show the worktree
exec wtx list
stderr 'main'

# Add another worktree
exec wtx add --skip-setup develop
exists worktrees/develop

# List should show both
exec wtx list
stderr 'main'
stderr 'develop'

# Remove one
exec wtx remove develop
stderr 'Removed worktree'
! exists worktrees/develop

# List should show only main
exec wtx list
stderr 'main'

# Remove the main branch worktree (should succeed, branch preserved)
exec wtx remove main
stderr 'branch preserved'
stderr 'Removed worktree'
! exists worktrees/main

# Re-add the main branch worktree
exec wtx add --skip-setup main
exists worktrees/main
