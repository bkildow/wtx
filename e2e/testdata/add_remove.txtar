[!exec:git] skip 'git not available'

# Set up a project with a remote repo that has extra branches
setup-repo develop feature/login
setup-project

cd $WORK/project

# Add a worktree for the default branch
exec wtx add --skip-setup main
exists worktrees/main

# List should show the worktree
exec wtx list
stderr 'main'

# Add another worktree
exec wtx add --skip-setup develop
exists worktrees/develop

# List should show both
exec wtx list
stderr 'main'
stderr 'develop'

# Remove one; its branch is merged, so it is deleted without a kept notice
exec wtx remove develop
stderr 'Removed worktree'
! stderr 'kept'
! exists worktrees/develop
! exec git --git-dir .bare rev-parse --verify --quiet refs/heads/develop

# Removing a worktree whose branch has unmerged commits keeps the branch and
# prints the exact delete command instead of git's hints
exec wtx add --skip-setup wip
exec git -C worktrees/wip commit --allow-empty -m wip
# --dry-run proposes the safe delete and keeps both worktree and branch
exec wtx --dry-run remove wip
stderr '\[dry-run\] git --git-dir \S+ branch -d wip'
! stderr 'kept'
exists worktrees/wip

# Removing it from inside prints only the project root to stdout, for the
# shell wrapper
cd worktrees/wip
exec wtx remove wip
stdout '^\S+/project\n$'
stderr 'Branch wip kept: git sees it as not fully merged'
stderr 'git --git-dir \S+/\.bare branch -D wip'
stderr 'Removed worktree: wip \(branch kept\)'
! stderr 'hint:'
cd $WORK/project
! exists worktrees/wip
exec git --git-dir .bare rev-parse --verify --quiet refs/heads/wip

# List should show only main
exec wtx list
stderr 'main'

# Remove the main branch worktree (should succeed, branch preserved)
exec wtx remove main
stderr 'branch preserved'
stderr 'Removed worktree'
! exists worktrees/main

# Re-add the main branch worktree
exec wtx add --skip-setup main
exists worktrees/main
