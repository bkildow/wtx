[!exec:git] skip 'git not available'

setup-repo develop
setup-project

cd $WORK/project

cp $WORK/with-scripts.yml .worktree.yml
mkdir bin
cp $WORK/probe.sh bin/probe
chmod 755 bin/probe
cp $WORK/probe.sh bin/noexec

exec wtx add --skip-setup main
exists worktrees/main

# From the project root: runs in cwd, worktree vars are empty.
exec wtx run probe one two
exists probe-out.txt
grep 'name=probe' probe-out.txt
grep 'root='$WORK'/project' probe-out.txt
grep 'branch=$' probe-out.txt
grep 'args=one two' probe-out.txt
rm probe-out.txt

# From inside a worktree: cwd and env come from that worktree.
cd $WORK/project/worktrees/main
exec wtx run probe --flag
exists $WORK/project/worktrees/main/probe-out.txt
grep 'branch=main' $WORK/project/worktrees/main/probe-out.txt
grep 'wtpath='$WORK'/project/worktrees/main' $WORK/project/worktrees/main/probe-out.txt
grep 'shared='$WORK'/project/shared' $WORK/project/worktrees/main/probe-out.txt
grep 'mainbranch=main' $WORK/project/worktrees/main/probe-out.txt
grep 'mainpath='$WORK'/project/worktrees/main' $WORK/project/worktrees/main/probe-out.txt
grep 'args=--flag' $WORK/project/worktrees/main/probe-out.txt
! exists $WORK/project/probe-out.txt
rm $WORK/project/worktrees/main/probe-out.txt
cd $WORK/project

# Dry run resolves but does not execute.
exec wtx run --dry-run probe
! exists probe-out.txt

# Unknown, missing, and non-executable scripts fail (shim drops messages; check exit code).
! exec wtx run nope
! exec wtx run missing
! exec wtx run noexec

# Exit code propagates.
cp $WORK/fail.sh bin/fail
chmod 755 bin/fail
! exec wtx run fail

cp $WORK/no-scripts.yml .worktree.yml
exec wtx run probe
stderr 'No scripts configured'

exec wtx run --help
stdout 'Runs a script configured under the "scripts" key'

-- with-scripts.yml --
version: 1
git_dir: .bare
worktree_dir: worktrees
shared_dir: shared
main_branch: main
scripts:
  probe: bin/probe
  noexec: bin/noexec
  missing: bin/missing
  fail: bin/fail
-- no-scripts.yml --
version: 1
git_dir: .bare
worktree_dir: worktrees
shared_dir: shared
-- probe.sh --
#!/bin/sh
# Both prefixes must be exported and agree, including empty worktree values.
set -eu
[ "${WTX_SCRIPT_NAME?}" = "${WT_SCRIPT_NAME?}" ]
[ "${WTX_PROJECT_ROOT?}" = "${WT_PROJECT_ROOT?}" ]
[ "${WTX_WORKTREE_PATH?}" = "${WT_WORKTREE_PATH?}" ]
[ "${WTX_WORKTREE_ID?}" = "${WT_WORKTREE_ID?}" ]
[ "${WTX_BRANCH_NAME?}" = "${WT_BRANCH_NAME?}" ]
[ "${WTX_SHARED_PATH?}" = "${WT_SHARED_PATH?}" ]
[ "${WTX_MAIN_BRANCH?}" = "${WT_MAIN_BRANCH?}" ]
[ "${WTX_MAIN_WORKTREE_PATH?}" = "${WT_MAIN_WORKTREE_PATH?}" ]
{
  echo "name=$WTX_SCRIPT_NAME"
  echo "root=$WTX_PROJECT_ROOT"
  echo "wtpath=$WTX_WORKTREE_PATH"
  echo "branch=$WTX_BRANCH_NAME"
  echo "shared=$WTX_SHARED_PATH"
  echo "mainbranch=$WTX_MAIN_BRANCH"
  echo "mainpath=$WTX_MAIN_WORKTREE_PATH"
  echo "args=$*"
} > probe-out.txt
-- fail.sh --
#!/bin/sh
exit 3
