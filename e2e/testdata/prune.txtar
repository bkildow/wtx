[!exec:git] skip 'git not available'

# The remote's default branch is master, so point prune at it. `develop` is
# created at the same commit as master and is therefore already merged.
setup-repo develop feature
setup-project

cd $WORK/project
cp $WORK/config.yml .worktree.yml

exec git --git-dir=.bare worktree add --relative-paths worktrees/develop develop
exec git --git-dir=.bare worktree add --relative-paths worktrees/feature feature

# Dirty the develop worktree.
cp $WORK/scratch.txt worktrees/develop/scratch.txt

# Without --force the dirty worktree is listed but kept; the clean one goes.
exec wtx prune --yes
stderr 'develop.*merged.*dirty'
stderr 'feature.*merged.*clean'
stderr 'uncommitted changes and will be kept'
stderr 'Removing worktree: feature'
! stderr 'Removing worktree: develop'
stderr 'Pruned 1 worktree\(s\), kept 1 with uncommitted changes'
exists worktrees/develop/scratch.txt
! exists worktrees/feature

# Nothing removable left without --force: no prompt, no removal.
exec wtx prune --yes
stderr 'Nothing to prune'
exists worktrees/develop/scratch.txt

# Dry run never removes anything, forced or not.
exec wtx --dry-run prune --force
stderr 'develop.*merged.*dirty'
exists worktrees/develop/scratch.txt

# --force removes the dirty merged worktree.
exec wtx prune --force --yes
stderr 'Removing worktree: develop'
stderr 'Pruned 1 worktree\(s\)'
! stderr 'kept'
! exists worktrees/develop

# A squash-merged branch is pruned, but git still calls it unmerged, so the
# branch is kept and the exact command to delete it is printed.
exec wtx add --skip-setup squashed
cp $WORK/squash.txt worktrees/squashed/squash.txt
exec git -C worktrees/squashed add squash.txt
exec git -C worktrees/squashed commit -m 'add squash.txt'
exec wtx add --skip-setup master
cp $WORK/squash.txt worktrees/master/squash.txt
exec git -C worktrees/master add squash.txt
exec git -C worktrees/master commit -m 'squash: add squash.txt'
exec wtx prune --yes
stderr 'Removing worktree: squashed'
stderr 'Branch squashed kept: git sees it as not fully merged'
stderr 'git --git-dir \S+/\.bare branch -D squashed'
stderr 'Pruned 1 worktree\(s\), kept 1 branch\(es\) git calls unmerged'
! stderr 'hint:'
! exists worktrees/squashed
exec git --git-dir .bare rev-parse --verify --quiet refs/heads/squashed

-- config.yml --
version: 1
git_dir: .bare
worktree_dir: worktrees
shared_dir: shared
main_branch: master
-- scratch.txt --
uncommitted
-- squash.txt --
squashed change
