[!exec:git] skip 'git not available'

# Set up a normal git repo (git identity from setupEnv env vars)
exec git init myrepo
cd myrepo
exec git commit --allow-empty -m 'initial'

# --dry-run prints every path it would create and writes nothing
exec wtx --dry-run init
stderr 'mkdir -p .*/\.wtx-home/myrepo$'
stderr 'write .*/\.wtx-home/myrepo/project\.yml'
stderr 'mkdir -p .*/\.wtx-home/myrepo/shared/copy'
stderr 'mkdir -p .*/\.wtx-home/myrepo/shared/symlink'
stderr 'mkdir -p .*/\.wtx-home/myrepo/worktrees'
stderr 'mkdir -p .*/\.wtx-home/myrepo/bin'
stderr 'write .*/\.wtx-home/myrepo/bin/refresh'
stderr 'write .*/myrepo/\.worktree\.yml'
stderr 'git --git-dir .*/myrepo/\.git config --local wtx\.name myrepo'
! exists .worktree.yml
! exists $WTX_HOME/myrepo
! exec git config --local wtx.name

# wtx init keeps worktrees and shared files under WTX_HOME (~/.wtx)
exec wtx init
stderr 'Initialized wtx project'
stderr 'Worktrees: .*\.wtx-home/myrepo/worktrees'
stderr '\.worktreeinclude'
! stderr '\.gitignore'

# The repo only gains .worktree.yml
exists .worktree.yml
! exists .worktrees
exists $WTX_HOME/myrepo/shared/copy
exists $WTX_HOME/myrepo/shared/symlink
exists $WTX_HOME/myrepo/worktrees
exists $WTX_HOME/myrepo/bin/refresh
exists $WTX_HOME/myrepo/project.yml
grep 'root: .*myrepo' $WTX_HOME/myrepo/project.yml

# The committed config carries no machine-local paths: worktree_dir,
# shared_dir and scripts are left out, and the name lives in local git config.
grep 'version: 1' .worktree.yml
grep 'git_dir: .git' .worktree.yml
! grep '^worktree_dir:' .worktree.yml
! grep '^shared_dir:' .worktree.yml
! grep '^scripts:' .worktree.yml
! grep 'myrepo' .worktree.yml
! grep 'wtx-home' .worktree.yml
exec git config --local wtx.name
stdout '^myrepo$'

# The starter refresh script runs from bin/ without a scripts entry.
exec wtx run refresh
stderr 'not implemented'
stderr 'Running refresh: .*\.wtx-home/myrepo/bin/refresh'

# Re-running init on a set-up clone is a friendly no-op
cp .worktree.yml $WORK/config-before
exec wtx init
stderr 'already set up'
cmp .worktree.yml $WORK/config-before

# Worktrees are created under WTX_HOME
exec wtx add --skip-setup feature
exists $WTX_HOME/myrepo/worktrees/feature/.git
exec wtx list
stderr 'feature'
stderr '\.wtx-home/myrepo/worktrees/feature'
! stderr '~'

# Commands run from the shared dir find the project via the marker
cd $WTX_HOME/myrepo/shared
exec wtx root
stdout 'myrepo$'
